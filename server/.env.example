# ─── PulseBoard API environment ───────────────────────────────
# Copy this file to `.env` and fill in the values.

# Port the API listens on
PORT=5000

# Node environment: development | production
NODE_ENV=development

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/pulseboard
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulseboard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pulseboard

# Secret used to sign JWTs — use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Where the React client is served from (used for CORS + Socket.io).
# Comma-separate multiple origins if needed.
CLIENT_URL=http://localhost:5173
